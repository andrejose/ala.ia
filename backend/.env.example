# Copie para .env e preencha com os dados do projeto Supabase.
# Para o Supabase local, rode `npx supabase status` e use API_URL e PUBLISHABLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
PORT=3001

# Produção (já definidas no Dockerfile; aqui só se quiser testar sem o Docker)
# NODE_ENV=production
# STATIC_DIR=../frontend/dist
# AUTH_RATE_LIMIT=20

# E-mail de convite (opcional). Sem SMTP_HOST, MAIL_FROM e APP_URL, o convite
# é criado sem e-mail. Ver docs/publicacao.md.
# APP_URL=https://ala.andrejose.com.br
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Ala.ia <convites@andrejose.com.br>
