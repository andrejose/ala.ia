# Copie para .env e preencha com os dados do projeto Supabase.
# Para o Supabase local, rode `npx supabase status` e use API_URL e PUBLISHABLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
PORT=3001

